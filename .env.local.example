# 复制为 .env.local 后填写。此文件被 .gitignore 忽略，不会入库。
#
#   cp .env.local.example .env.local
#
# 应用端口（默认 8099）。
CODESPAR_PORT=8099

# 监听地址（默认 127.0.0.1）。公网请用 Caddy/nginx 反代，不要改成 0.0.0.0 除非已设访问口令。
#CODESPAR_BIND=127.0.0.1

# 默认访问口令（至少 8 位）。本机开发不设则免口令。
# 监听非回环地址时必须设置，否则拒绝启动。
# 设置页改过口令后以本机 access.hash 为准，这项只当默认/恢复用。
#CODESPAR_ACCESS_PASSWORD=

# 公网 Origin，一般不用填。浏览器会按当前域名校验。
#CODESPAR_PUBLIC_ORIGIN=

# 开发前端端口（默认 5173）。必须与 CODESPAR_PORT 成对修改。
#CODESPAR_VITE_PORT=5173

# SQLite 数据库文件路径（默认 ~/.codespar/codespar.db，一般无需设置）
# 数据库文件由应用首次启动时自动创建，无需手动建库
# 并行窗口禁止共用默认库，例如：
#CODESPAR_DB_PATH=$HOME/.codespar/worktrees/<切片名>.db

# Markdown 与图片资料根（默认跟随数据库，位于数据库同目录下的 notes/）
#CODESPAR_NOTES_DIR=/var/codespar/notes

# AES 主密钥（用于加密存储各家模型的 apiKey）。
# 留空则首次启动自动生成到 ~/.codespar/master.key（权限 600）。
#CODESPAR_MASTER_KEY=
