# 服务器环境变量示例。复制后按需修改，不要提交真实密钥。
#
#   sudo mkdir -p /var/lib/codespar
#   sudo cp .env.server.example /var/lib/codespar/codespar.env
#   # 编辑后在 systemd 里用 EnvironmentFile=/var/lib/codespar/codespar.env

CODESPAR_JAR=/opt/codespar/codespar.jar
CODESPAR_PORT=8099
CODESPAR_BIND=127.0.0.1
CODESPAR_DB_PATH=/var/lib/codespar/codespar.db
CODESPAR_MASTER_KEY_FILE=/var/lib/codespar/master.key
# 默认访问口令（至少 8 位）。设置页可以改；改过之后以 access.hash 为准。
CODESPAR_ACCESS_PASSWORD=

# 一般不用填。只有浏览器域名和 Host 对不上时才需要。
# CODESPAR_PUBLIC_ORIGIN=https://codespar.mmy.qd.je

# 可选：用环境变量代替 master.key 文件（Base64 编码的 32 字节）
# openssl rand -base64 32
# CODESPAR_MASTER_KEY=

# 可选 JVM 参数
# CODESPAR_JAVA_OPTS=-Xms256m -Xmx1g
